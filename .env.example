# ===== LLM 配置 =====
# 默认使用的服务商别名（见 src/llm/client.py 内置注册表）: glm / deepseek / qwen / openai
LLM_PROVIDER=glm

# 也可不选内置服务商，直接指定任意 OpenAI 兼容端点（优先级高于 LLM_PROVIDER）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# API Key（至少给 LLM_API_KEY 或 <PROVIDER>_API_KEY 之一，如 GLM_API_KEY）
LLM_API_KEY=

# 各服务商的 Key 也可以分开放置
GLM_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# 采样参数
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ===== 数据库 =====
DB_PATH=data/ecommerce.db

# ===== 评测 =====
EVAL_DATASET_PATH=evals/dataset
EVAL_REPORT_DIR=evals/reports
